{
  "name": "{{ name }}",
  "description": "{{ description }}",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "{{ packageManager }}",
  "keywords": [
    "{{ name }}",
    "krawler",
    "kalisio"
  ],
  "author": {
    "name": "{{ author.name }}",
    "email": "{{ author.email }}",
    "url": "{{ author.url }}"
  },
  "contributors": [],
  "license": "{{#if license}}MIT{{else}}UNLICENSED{{/if}}",
  "repository": {
    "type": "git",
    "url": "git+{{ monorepoUrl }}/{{ monorepoName }}.git",
    "directory": "packages/{{ name }}"
  },
  "bugs": {
    "url": "{{ monorepoUrl }}/{{ monorepoName }}/issues"
  },
  "homepage": "{{ monorepoUrl }}/{{ monorepoName }}/tree/main/packages/{{ name }}",
  "dependencies": {
    "lodash": "catalog:",
    "winston": "catalog:"
  },
  "peerDependencies": {
    "@kalisio/krawler": "{{#if krawlerEkosystem}}workspace:*{{else}}catalog:*{{/if}}"
  },
  "engines": {
    "node": ">=20",
    "pnpm": ">=10"
  }
}
