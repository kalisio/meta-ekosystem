{
  "name": "{{ name }}",
  "description": "{{ description }}",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "{{ packageManager }}",
  "scripts": {
    "build": "DOCKER_BUILDKIT=1 docker build -t {{ name }}:${TAG:-latest} -f ./Dockerfile ../..",
    "dev": "node --watch src/main.js",
    "lint": "standard --fix",
    "test": "vitest run --coverage"
  },
  "keywords": [
    "{{ name }}"
  ],
  "author": {
    "name": "{{ author.name }}",
    "email": "{{ author.email }}",
    "url": "{{ author.url }}"
  },
  "contributors": [],
  "license": "{{#if license}}MIT{{else}}UNLICENSED{{/if}}",
  "repository": {
    "type": "git",
    "url": "git+{{ monorepoUrl }}/{{ monorepoName }}.git",
    "directory": "packages/{{ name }}"
  },
  "bugs": {
    "url": "{{ monorepoUrl }}/{{ monorepoName }}/issues"
  },
  "homepage": "{{ monorepoUrl }}/{{ monorepoName }}/tree/main/packages/{{ name }}",
  "dependencies": {
    "@feathersjs/commons": "catalog:",
    "@feathersjs/configuration": "catalog:",
    "@feathersjs/errors": "catalog:",
    "@feathersjs/express": "catalog:",
    "@feathersjs/feathers": "catalog:",
    "@feathersjs/schema": "catalog:",
    "@kalisio/feathers-distributed": "catalog:",
    "compression": "catalog:",
    "is-docker":"catalog:",
    "cors": "catalog:",
    "debug": "catalog:",
    "feathers-hooks-common": "catalog:",
    "helmet": "catalog:",
    "winston": "catalog:",
    "winston-daily-rotate-file": "catalog:"
  },
  "devDependencies": {},
  "engines": {
    "node": ">=20",
    "pnpm": ">=10"
  }
}
